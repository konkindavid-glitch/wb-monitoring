# Образец. Реальные значения задаются переменными окружения в панели Амверы
# и в репозиторий не попадают.

# Внутренний хост базы в Амвере — из карточки проекта monitoring-db
DATABASE_URL=postgresql://monitoring:ПАРОЛЬ@amvera-davidkonkin-cnpg-monitoring-db-rw:5432/monitoring

# Один ключ на все модели, оплата российской картой, без блокировок.
# Приоритетнее ANTHROPIC_API_KEY, если заданы оба.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Запасной вариант — прямой Anthropic
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Постоянный диск Амверы, иначе doc_diff после перезапуска не с чем сравнивать
SNAPSHOT_DIR=/data/snapshots
