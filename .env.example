# Образец. Реальные значения задаются переменными окружения в панели Амверы
# и в репозиторий не попадают.

# Подключение к базе. Два равноправных пути — достаточно любого.
#
# Путь 1: одной строкой. Пароль обязан быть percent-кодирован: символы
# @ : / ? # % ломают разбор строки ещё до попытки подключиться.
DATABASE_URL=postgresql://monitoring:ПАРОЛЬ@amvera-davidkonkin-cnpg-monitoring-db-rw:5432/monitoring
#
# Путь 2: отдельными переменными. Экранировать не нужно ничего — годится
# для любого пароля. Остальные параметры имеют разумные значения по умолчанию.
DB_PASSWORD=
# DB_HOST=amvera-davidkonkin-cnpg-monitoring-db-rw
# DB_PORT=5432
# DB_USER=monitoring
# DB_NAME=monitoring

# Один ключ на все модели, оплата российской картой, без блокировок.
# Приоритетнее ANTHROPIC_API_KEY, если заданы оба.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Модель для написания постов. Не задана — пишет та же, что размечает
# факторы. Разметка идёт сотнями материалов за прогон, поэтому там Haiku;
# пост пишется по одному и редко, и для него уместна модель посильнее.
WRITER_MODEL=

# Запасной вариант — прямой Anthropic
ANTHROPIC_API_KEY=

TELEGRAM_BOT_TOKEN=
# Чат модерации: сюда приходят карточки с кнопками
TELEGRAM_CHAT_ID=
# Канал публикации. Не задан — готовый пост уходит обратно в чат модерации,
# откуда его можно переслать руками.
TELEGRAM_CHANNEL_ID=

# Откуда берётся фон обложки:
#   generated — рисует модель через OpenRouter (по умолчанию),
#               при отказе подставляется фото из статьи;
#   photo     — только настоящее фото из статьи (og:image), бесплатно;
#   off       — фирменная плашка, без внешних запросов.
COVER_SOURCE=generated
IMAGE_MODEL=google/gemini-2.5-flash-image

# Два разбора в день, время московское
EXPLAINER_TIMES=10:00,18:00

# Постоянный диск Амверы, иначе doc_diff после перезапуска не с чем сравнивать
SNAPSHOT_DIR=/data/snapshots
